{
  "name": "AJ Netweb Intercom & Door Station Studio",
  "version": "1.3.4",
  "slug": "ajnetweb_intercom",
  "description": "Professional Video Intercom & Access Control Terminal Studio for Hikvision & Dahua with Instant SADP & ONVIF Device Discovery. Room-to-Room Inter-Display Calling, Villa All-Call PA Broadcast, direct ISAPI QR code & PIN provisioning, and dynamic mobile push.",
  "url": "https://github.com/ajnetworksa/aj-netweb-addon",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "startup": "services",
  "boot": "auto",
  "init": false,
  "stage": "stable",
  "host_network": true,
  "hassio_api": true,
  "hassio_role": "manager",
  "homeassistant_api": true,
  "map": [
    "homeassistant_config:rw",
    "share:rw"
  ],
  "options": {
    "brand": "auto",
    "host": "",
    "http_port": 80,
    "rtsp_port": 554,
    "username": "admin",
    "password": "",
    "door_1_name": "Main Gate",
    "door_2_name": "Pedestrian Door",
    "unlock_duration_sec": 3,
    "auto_snapshot_on_ring": true,
    "ha_notify_on_ring": true,
    "push_notify_mode": "all_mobile_devices",
    "critical_push_sound": true,
    "log_level": "info"
  },
  "schema": {
    "brand": "list(auto|hikvision|dahua)",
    "host": "str",
    "http_port": "port",
    "rtsp_port": "port",
    "username": "str",
    "password": "password",
    "door_1_name": "str?",
    "door_2_name": "str?",
    "unlock_duration_sec": "int?",
    "auto_snapshot_on_ring": "bool?",
    "ha_notify_on_ring": "bool?",
    "push_notify_mode": "list(all_mobile_devices|disabled)?",
    "critical_push_sound": "bool?",
    "log_level": "list(debug|info|warning|error)"
  },
  "ingress": true,
  "ingress_port": 8091,
  "panel_icon": "mdi:doorbell-video",
  "panel_title": "Door Station"
}
