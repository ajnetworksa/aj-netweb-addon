{
  "name": "AJ Netweb Dashboard Suite",
  "version": "3.9.0",
  "slug": "ajnetweb_dashboard",
  "description": "Installer studio for a premium, responsive Home Assistant dashboard (phone, tablet, wall panel) that builds itself from your Areas and Floors. Bundles the AJ Netweb UI kit - no HACS, no card-mod.",
  "url": "https://github.com/ajnetworksa/aj-netweb-addon",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "startup": "services",
  "boot": "auto",
  "init": false,
  "stage": "stable",
  "ingress": true,
  "ingress_port": 8099,
  "panel_icon": "mdi:view-dashboard-variant",
  "panel_title": "Dashboard Suite",
  "hassio_api": true,
  "hassio_role": "manager",
  "homeassistant_api": true,
  "map": [
    "homeassistant_config:rw",
    "share:rw"
  ],
  "options": {
    "default_theme": "apple_frosted_glass",
    "dashboard_url": "ajnetweb-home",
    "dashboard_title": "Smart Home",
    "auto_register_resources": true
  },
  "schema": {
    "default_theme": "list(apple_frosted_glass|cyber_luxury|scandinavian_minimal|modern_bento|oled_stealth|hotel_suite)",
    "dashboard_url": "str",
    "dashboard_title": "str",
    "auto_register_resources": "bool"
  }
}
