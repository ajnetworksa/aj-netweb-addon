{
  "name": "AJ Netweb CCTV & NVR Studio",
  "version": "1.0.0",
  "slug": "ajnetweb_cctv",
  "description": "Professional Hikvision & Dahua CCTV Camera Viewer, Multi-channel Grid, Full PTZ Controller, and NVR Playback Timeline for Home Assistant.",
  "url": "https://github.com/ajnetworksa/aj-netweb-addon",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "startup": "services",
  "boot": "auto",
  "init": false,
  "stage": "stable",
  "hassio_api": true,
  "hassio_role": "manager",
  "homeassistant_api": true,
  "options": {
    "nvr_brand": "auto",
    "host": "",
    "http_port": 80,
    "rtsp_port": 554,
    "username": "admin",
    "password": "",
    "stream_quality": "sub",
    "refresh_interval_sec": 2,
    "log_level": "info"
  },
  "schema": {
    "nvr_brand": "list(auto|hikvision|dahua)",
    "host": "str",
    "http_port": "port",
    "rtsp_port": "port",
    "username": "str",
    "password": "password",
    "stream_quality": "list(sub|main)",
    "refresh_interval_sec": "int?",
    "log_level": "list(debug|info|warning|error)"
  },
  "ingress": true,
  "ingress_port": 8098,
  "panel_icon": "mdi:cctv",
  "panel_title": "CCTV Studio"
}
