{
  "name": "AJ Netweb Remote Access",
  "version": "1.2.1",
  "slug": "ajnetweb_tunnel",
  "description": "Secure remote access, live cameras and two-way intercom for your home through AJ Netweb.",
  "url": "https://ajnetweb.dpdns.org",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "startup": "services",
  "boot": "auto",
  "init": false,
  "stage": "stable",
  "hassio_api": true,
  "hassio_role": "manager",
  "homeassistant_api": true,
  "map": [
    "homeassistant_config:rw"
  ],
  "options": {
    "license_key": "",
    "server": "api.ajnetweb.dpdns.org",
    "allow_installer_management": true,
    "manage_webrtc_config": true,
    "log_level": "info"
  },
  "schema": {
    "license_key": "password",
    "server": "str?",
    "allow_installer_management": "bool",
    "manage_webrtc_config": "bool",
    "log_level": "list(debug|info|warning|error)"
  },
  "ingress": true,
  "ingress_port": 8099,
  "panel_icon": "mdi:shield-home",
  "panel_title": "AJ Netweb"
}
